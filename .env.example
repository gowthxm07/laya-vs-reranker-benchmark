# PatternRAG Lab — Environment Configuration Template
# Copy this file to .env.local for local overrides. Do NOT commit .env.local.

# -----------------------------------------------------------------------------
# Local Embedding Provider Configuration (Phase 2 Shared Retrieval)
# -----------------------------------------------------------------------------
# Active Local Provider: Ollama
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text

# Local Vector Storage Persistence Path
VECTOR_STORE_PATH=./data/vector-store.json

# Deterministic Chunking Configuration (characters)
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# Default Candidate Pool Size
TOP_K=10

# -----------------------------------------------------------------------------
# Downstream LLM Provider Configuration (Reserved for Phase 4)
# -----------------------------------------------------------------------------
# Primary Local Generation Model
OLLAMA_MODEL=llama3.2:3b

# Optional Secondary Remote Provider (No keys required for Phase 1/2)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct

# -----------------------------------------------------------------------------
# Evaluator Strategy Configuration (Reserved for Phase 3/4)
# -----------------------------------------------------------------------------
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
LAYA_API_ENDPOINT=http://localhost:8080/v1
LAYA_API_KEY=

# -----------------------------------------------------------------------------
# Application Runtime
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="PatternRAG Lab"
NEXT_PUBLIC_APP_VERSION="0.2.0-phase2"
NODE_ENV=development
