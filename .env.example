# PatternRAG Lab — Environment Configuration Template
# Copy this file to .env.local for local overrides. Do NOT commit .env.local.

# -----------------------------------------------------------------------------
# LLM Provider Configuration
# -----------------------------------------------------------------------------
# Primary Local Provider: Ollama (default target for fair comparison)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Optional Secondary Provider: OpenRouter (future benchmark fallback if local model is insufficient)
# Note: Phase 1 does NOT require API keys and performs no remote LLM calls.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct

# -----------------------------------------------------------------------------
# Evaluator Strategy Configuration
# -----------------------------------------------------------------------------
# Cross-Encoder Reranker model identifier (for Advanced RAG path)
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Laya Service Configuration (for Laya RAG path)
LAYA_API_ENDPOINT=http://localhost:8080/v1
LAYA_API_KEY=

# -----------------------------------------------------------------------------
# Application Runtime Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="PatternRAG Lab"
NEXT_PUBLIC_APP_VERSION="0.1.0-phase1"
NODE_ENV=development
